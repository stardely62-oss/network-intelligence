{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Network Intelligence",
  "version": "0.1.0",
  "identifier": "io.github.stardely62.networkintelligence",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Network Intelligence",
        "width": 1320,
        "height": 840,
        "minWidth": 1024,
        "minHeight": 640,
        "backgroundColor": "#0d0f12"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Network Intelligence contributors",
    "copyright": "MIT License",
    "category": "DeveloperTool",
    "shortDescription": "Network activity and connection diagnostics for Windows applications",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
